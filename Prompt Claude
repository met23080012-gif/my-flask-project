Kết quả pytest:
17 passed, 1 failed
Test fail:
E assert 200 == 400
Source code hiện tại:
from flask import Flask, jsonify, request
app = Flask(__name__)
app.json.ensure_ascii = False
@app.route("/")
def home():
    return "Hello World"
@app.route("/score")
def calculate_score():
    score_str = request.args.get("score")
    if score_str is None:
        return jsonify({"error": "Score parameter is required"}), 400
    if score_str.strip() == "":
        return jsonify({"error": "Score cannot be empty"}), 400
    try:
        score = float(score_str)
    except ValueError:
        return jsonify({"error": "Score must be a valid number"}), 400
    if score < 0 or score > 10:
        return jsonify({"error": "Score must be between 0 and 10"}), 400
    if score < 5:
        classification = "Yếu"
    elif score < 6.5:
        classification = "Trung bình"
    elif score < 8:
        classification = "Khá"
    else:
        classification = "Giỏi"
    return jsonify({"score": score, "classification": classification}), 200
